FROM python:3.12-slim

WORKDIR /app

# Copy emulator code
COPY emulators/vendotek_pos_emulator.py /app/vendotek_pos_emulator.py

# Make executable
RUN chmod +x /app/vendotek_pos_emulator.py

# Expose POS terminal port
EXPOSE 4001

# Run emulator
CMD ["python", "/app/vendotek_pos_emulator.py", "--host", "${EMULATOR_HOST:-0.0.0.0}", "--port", "${EMULATOR_PORT:-4001}"]

