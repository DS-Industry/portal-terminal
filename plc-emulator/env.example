# Environment variables for PLC Emulator
# Copy this file to .env and modify as needed
# These values override settings in config.py

# Network Configuration
# Host to bind to (0.0.0.0 = all interfaces, or specific IP)
PLC_HOST=0.0.0.0

# Port for Modbus TCP (502 is standard, but requires root on Linux)
# Use 5020 or other port if running without root privileges
PLC_PORT=5020

# Modbus Unit ID (Slave ID)
PLC_UNIT_ID=1

# Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable detailed Modbus protocol debugging
# Set to 'true' to see all Modbus requests/responses
DEBUG_MODBUS=false

# Docker Compose Note:
# When using docker-compose, PLC_PORT in .env refers to the HOST port
# The container always uses port 502 internally
# Example: PLC_PORT=5020 maps host:5020 -> container:502

